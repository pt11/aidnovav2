{
	"name": "aidnovav2",
	"description": "A template for building a React application with Vite, Hono, and Cloudflare Workers",
	"cloudflare": {
		"label": "Vite React Template",
		"products": [
			"Workers"
		],
		"categories": [],
		"preview_icon_url": "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/532a5378-9717-4964-385b-5fafd2160200/public",
		"preview_image_url": "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/ec7f4be5-d1d6-4e94-0851-126341745400/preview",
		"publish": true
	},
	"dependencies": {
		"@tanstack/react-query": "5.105.0",
		"@tiptap/core": "2.27.3",
		"@tiptap/extension-link": "2.27.3",
		"@tiptap/pm": "2.27.3",
		"@tiptap/react": "2.27.3",
		"@tiptap/starter-kit": "2.27.3",
		"better-auth": "1.7.14",
		"drizzle-orm": "0.45.4",
		"hono": "4.11.1",
		"lucide-react": "1.65.0",
		"pdfjs-dist": "4.10.38",
		"react": "19.2.1",
		"react-dom": "19.2.1",
		"wouter": "3.13.0"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "1.52.1",
		"@eslint/js": "9.39.1",
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "24.10.1",
		"@types/react": "19.2.7",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "5.1.1",
		"drizzle-kit": "0.31.11",
		"eslint": "9.39.2",
		"eslint-plugin-react-hooks": "7.0.1",
		"eslint-plugin-react-refresh": "0.4.24",
		"globals": "16.5.0",
		"tailwindcss": "4.3.3",
		"typescript": "5.9.3",
		"typescript-eslint": "8.48.0",
		"vite": "^7.0.0",
		"wrangler": "4.136.1"
	},
	"private": true,
	"scripts": {
		"build": "tsc -b && vite build",
		"cf-typegen": "wrangler types",
		"check": "tsc && vite build && wrangler deploy --dry-run",
		"deploy": "wrangler deploy",
		"dev": "vite",
		"lint": "eslint .",
		"preview": "npm run build && vite preview",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply aidnova --local",
		"db:migrate:remote": "wrangler d1 migrations apply aidnova --remote",
		"test:api": "node --test tests/*.test.mjs"
	},
	"type": "module"
}
